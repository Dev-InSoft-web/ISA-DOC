# Lab LangGraph (FitDocs RAG + corpus YouTube) — copiar a lab-langgraph.env (NO versionar)
# Proyecto: Contapyme/lab-langgraph · NO es PatyIA producción (AYUDASCP-IA)
# Usado por ISA-DOC (npm run lab:*) y por lab-langgraph (Azure Functions local).

DATABASE_HOST_INTERNAL=dpg-d8g48b4p3tds738kr070-a
DATABASE_HOST_EXTERNAL=dpg-d8g48b4p3tds738kr070-a.oregon-postgres.render.com
DATABASE_PORT=5432
DATABASE_NAME=langlab
DATABASE_USER=langlab_user
# DATABASE_PASSWORD=<panel Render>

# External (Azure, dev local fuera de Render):
# DATABASE_URL=postgresql://langlab_user:PASSWORD@dpg-d8g48b4p3tds738kr070-a.oregon-postgres.render.com/langlab

# Internal (solo servicios en Render):
# DATABASE_URL_INTERNAL=postgresql://langlab_user:PASSWORD@dpg-d8g48b4p3tds738kr070-a/langlab

# --- Groq (chat RAG + Whisper + proofread) — rotación 1/3 y 2/3 ---
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Hugging Face (embeddings RAG) ---
HUGGINGFACE_API_KEY=

# --- MiniMax (3/3: Whisper STT + proofread chat) — misma key en ISA-DOC y lab-langgraph ---
# Token Plan (suscripción): Subscription Key sk-cp-* desde https://platform.minimax.io/console/plan
# Pay-as-you-go: API Key sk-api-* desde https://platform.minimax.io/console/access + saldo en Balance
# NO mezclar: la sk-cp no consume Balance; la sk-api no consume cuota del plan.
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io
# MINIMAX_STT_API_BASE=https://gateway-con-stt-compatible
MINIMAX_STT_MODEL=whisper-large
MINIMAX_STT_MODE=auto
MINIMAX_CHAT_MODEL=MiniMax-M2.5
# MINIMAX_GROUP_ID=
# Pausa tras intento MiniMax antes de reintentar Groq (ms)
WHISPER_AFTER_MINIMAX_MS=30000

PGVECTOR_COLLECTION=fitdocs_v2

# Puerto local Azure Functions (local.settings.json Host.LocalHttpPort)
LAB_FUNCTIONS_PORT=5500
