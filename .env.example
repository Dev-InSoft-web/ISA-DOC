# ISA-DOC (front) — URL del backend lab-langgraph
# Local: Azure Functions en 5500
PUBLIC_LAB_LANGGRAPH_URL=http://127.0.0.1:5500

# Producción / staging del lab (ejemplo)
# PUBLIC_LAB_LANGGRAPH_URL=https://tu-lab-langgraph.azurewebsites.net

# Server-side (Astro API): reenvío MSSQL a lab sin credenciales locales
# LAB_LANGGRAPH_URL=http://127.0.0.1:5500
# ISA_DB_REMOTE_URL=http://127.0.0.1:5500/api/mssql/clientesis/exec
# ISA_PATY_DB_REMOTE_URL=http://127.0.0.1:5500/api/mssql/paty/exec
# ISA_DB_REMOTE_TOKEN=<JWT de POST /api/auth/token> (solo para proxy server-side)
